  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "token": "{{tokenAuditor}}",
    "route": "audit"
  }
}

docs {
  Decide si un rol puede acceder a una ruta. Lo consumen los microservicios.
}
