flowchart TB
    subgraph host["Maquina anfitriona"]
        navegador["Cliente HTTP<br/>localhost:8000"]

        subgraph docker["Docker Compose"]
            subgraph red["Red sa-net"]
                kong["sa-kong<br/>puerto 8000 publicado"]
                auth["sa-auth-api<br/>puerto 4000 interno"]
                authz["sa-authz-service<br/>puerto 4001 interno"]
                tx["sa-transactions-service<br/>puerto 4002 interno"]
                nt["sa-notifications-service<br/>puerto 4003 interno"]
                ap["sa-approvals-service<br/>puerto 4004 interno"]
                au["sa-audit-service<br/>puerto 4005 interno"]
                pg["sa-postgres<br/>puerto 5432 interno"]
            end

            vol[("Volumen pgdata")]
            conf["Configuracion del gateway<br/>montada de solo lectura"]
            init["Script de creacion de bases<br/>montado al iniciar"]
        end
    end

    navegador --> kong
    kong --> auth
    kong --> authz
    kong --> tx
    kong --> nt
    kong --> ap
    kong --> au

    auth --> pg
    tx --> pg
    nt --> pg
    ap --> pg
    au --> pg

    pg --- vol
    conf -.-> kong
    init -.-> pg

    classDef anfitriona fill:#f5f5f5,stroke:#9e9e9e,color:#212121
    classDef compose fill:#ede7f6,stroke:#7e57c2,color:#212121
    classDef redInterna fill:#e8f5e9,stroke:#43a047,color:#212121
    classDef cliente fill:#fff9c4,stroke:#f9a825,color:#212121
    classDef gateway fill:#ffcc80,stroke:#ef6c00,color:#212121
    classDef servicio fill:#bbdefb,stroke:#1565c0,color:#212121
    classDef basedatos fill:#80cbc4,stroke:#00695c,color:#212121
    classDef volumen fill:#f8bbd0,stroke:#ad1457,color:#212121
    classDef archivo fill:#cfd8dc,stroke:#455a64,color:#212121

    class host anfitriona
    class docker compose
    class red redInterna
    class navegador cliente
    class kong gateway
    class auth,authz,tx,nt,ap,au servicio
    class pg basedatos
    class vol volumen
    class conf,init archivo
