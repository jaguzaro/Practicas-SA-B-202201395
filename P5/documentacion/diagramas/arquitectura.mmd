graph TB
    subgraph externo["Externo al cluster"]
        cliente["Consumidor de la API"]
        generador["Generador de carga"]
    end

    subgraph cluster["Interno al cluster"]
        entrada["Punto de entrada HTTP"]

        subgraph plataforma["Namespace de la plataforma"]
            gateway["API Gateway"]

            subgraph servicios["Zona de servicios"]
                autenticacion["Autenticacion"]
                autorizacion["Autorizacion"]
                transacciones["Transacciones<br/>productor"]
                auditoria["Auditoria<br/>consumidor"]
            end

            subgraph datos["Zona de datos"]
                broker[("Broker de mensajeria")]
                basedatos[("Base de datos")]
            end

            registro["Trabajo programado<br/>registro periodico"]
            resumen["Trabajo programado<br/>resumen agregado"]

            intruso["Componente sin autorizacion"]
        end
    end

    cliente --> entrada
    generador --> entrada
    entrada --> gateway

    gateway --> autenticacion
    gateway --> autorizacion
    gateway --> transacciones
    gateway --> auditoria

    transacciones --> autorizacion
    auditoria --> autorizacion

    autenticacion --> basedatos
    transacciones --> basedatos
    auditoria --> basedatos
    registro --> basedatos
    resumen --> basedatos

    transacciones -.->|evento| broker
    broker -.->|consumo con confirmacion| auditoria
    resumen -.->|resumen| broker

    intruso x--x servicios
    intruso x--x datos

    nota["Limites de red<br/>Todo el trafico entrante esta denegado por defecto.<br/>Al gateway solo llega el punto de entrada.<br/>A cada servicio solo llegan quienes lo invocan.<br/>A la zona de datos solo llegan los servicios y trabajos autorizados.<br/>Linea continua flujo sincrono, linea punteada flujo asincrono."]

    classDef almacen fill:#eeeeee,stroke:#555555
    classDef bloqueado fill:#ffffff,stroke:#aa3333,stroke-dasharray: 4 3
    classDef leyenda fill:#ffffff,stroke:#999999
    class broker,basedatos almacen
    class intruso bloqueado
    class nota leyenda
